<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JAMP ZnO Plant — 3D Model &amp; Plot Plan</title></head>
<body>
<!--
================================================================================
  JAMP INDUSTRIES  —  ZINC OXIDE (ZnO) RECOVERY PLANT
  3D EQUIPMENT MODEL + TOP VIEW PLOT PLAN
--------------------------------------------------------------------------------
  DRAWING SCALE      : 1 world unit = 0.1 m  (all equipment modelled to size)
  PLOT SIZE          : 77.0 m (E-W)  x  57.0 m (N-S)
  BASIS OF DRAWING   : Process flow sheet (jampindustriesflowchart.pdf)
                       + hand marked block flow diagram (site sketch)
  PROCESS ROUTE      : Zinc ash -> HCl leaching -> filtration -> purification
                       -> alkali precipitation -> filtration -> drying (200-300 C)
                       -> milling -> packing (ZnO 500 kg/batch)
                       Spent brine -> RO -> permeate recycled to T-01
--------------------------------------------------------------------------------
  CODE MAP
    1  TOKENS ......... palette, service colours, rack elevations
    2  SCENE .......... renderer, cameras, lights, floor
    3  HELPERS ........ materials, primitives, canvas text
    4  BUILDERS ....... vessel / filter press / pump / dryer / RO ...
    5  LAYOUT ......... EQUIPMENT TABLE  (edit co-ordinates here)
    6  PIPING ......... LINE LIST        (edit routing here)
    7  PLOT ........... grid, gridlines, bay zones, north
    8  VIEW ........... camera control, 3D / plan switching
    9  UI ............. legend, filters, tooltip, spec panel
================================================================================
-->
<style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:100%;height:100%}
body{background:#070a0e;font-family:'Consolas','Courier New',monospace;overflow:hidden;
     min-height:600px}
#wrap{width:100%;height:100%;min-height:600px;position:relative;background:#070a0e}
canvas{display:block;position:absolute;top:0;left:0;touch-action:none}
#hud{position:absolute;inset:0;pointer-events:none}

/* ── toolbar ─────────────────────────────────────────────── */
#bar{position:absolute;top:0;left:0;right:0;height:40px;background:#0d1319;
     border-bottom:1px solid #1c2833;display:flex;align-items:center;gap:2px;
     padding:0 10px;pointer-events:all;flex-wrap:nowrap;overflow-x:auto}
#bar::-webkit-scrollbar{height:0}
.b{background:none;color:#6f8ca8;border:1px solid transparent;padding:5px 9px;
   font:10px 'Consolas',monospace;cursor:pointer;border-radius:2px;white-space:nowrap;letter-spacing:.3px}
.b:hover{background:#16212e;color:#cfe3f5}
.b.on{background:#0b2d4d;color:#5cc2ff;border-color:#17456f}
.sep{width:1px;height:20px;background:#1c2833;margin:0 6px;flex-shrink:0}
.blab{color:#33465a;font:9px 'Consolas',monospace;padding-right:4px;flex-shrink:0}

/* ── overlays ────────────────────────────────────────────── */
#mode-label{position:absolute;top:50px;left:14px;color:#5cc2ff;font:11px 'Consolas',monospace;
            letter-spacing:1.5px}
#mode-sub{position:absolute;top:66px;left:14px;color:#3d566e;font:9px 'Consolas',monospace;letter-spacing:.5px}

#spec{position:absolute;top:50px;right:14px;width:224px;background:#0b1219ee;
      border:1px solid #1c2833;border-radius:3px;padding:10px 12px;pointer-events:none}
#sp-tag{color:#5cc2ff;font:12px 'Consolas',monospace;font-weight:bold;letter-spacing:1px}
#sp-name{color:#8fa6bb;font:9px 'Consolas',monospace;margin:2px 0 7px;letter-spacing:.3px}
#sp-body{color:#5d768c;font:9px 'Consolas',monospace}
.sp-row{display:flex;gap:6px;margin:2px 0;font:9px 'Consolas',monospace;line-height:1.5}
.sp-k{color:#3d566e;min-width:64px;flex-shrink:0}
.sp-v{color:#7e99b0}

#legend{position:absolute;bottom:54px;left:14px;background:#0b1219ee;border:1px solid #1c2833;
        border-radius:3px;padding:9px 11px;pointer-events:all}
#lg-title{color:#3d566e;font:9px 'Consolas',monospace;letter-spacing:1px;margin-bottom:6px}
.lr{display:flex;align-items:center;gap:8px;margin:3px 0;cursor:pointer;opacity:1}
.lr.off{opacity:.28}
.ld{width:26px;height:3px;border-radius:2px;flex-shrink:0}
.lt{color:#7e99b0;font:9px 'Consolas',monospace}

#titleblock{position:absolute;bottom:54px;right:14px;width:250px;background:#0b1219ee;
            border:1px solid #1c2833;border-radius:3px;pointer-events:none}
#tb-h{padding:7px 10px;border-bottom:1px solid #1c2833}
#tb-h b{color:#cfe3f5;font:11px 'Consolas',monospace;letter-spacing:.5px}
#tb-h div{color:#3d566e;font:9px 'Consolas',monospace;margin-top:2px}
.tb-r{display:flex;border-bottom:1px solid #141d27}
.tb-r:last-child{border-bottom:none}
.tb-c{flex:1;padding:5px 10px;font:9px 'Consolas',monospace;color:#7e99b0}
.tb-c span{color:#33465a;display:block;font-size:8px;letter-spacing:.5px}

#north{position:absolute;bottom:150px;right:22px;width:58px;height:58px;pointer-events:none}

#sbar{position:absolute;bottom:0;left:0;right:0;height:30px;background:#090e13;
      border-top:1px solid #161f29;display:flex;align-items:center;padding:0 12px;gap:20px;pointer-events:all}
#sbar span{color:#33465a;font:9px 'Consolas',monospace;white-space:nowrap}
#coords{color:#2f8f5c}
#tip{position:absolute;display:none;background:#0b1219;border:1px solid #1c3a5a;border-radius:3px;
     padding:8px 11px;pointer-events:none;z-index:99;font:9px 'Consolas',monospace;color:#8fa6bb;
     max-width:210px;line-height:1.6}
#tip b{color:#5cc2ff;font-size:10px;letter-spacing:.5px}
#hint{position:absolute;bottom:54px;left:50%;transform:translateX(-50%);color:#243342;
      font:9px 'Consolas',monospace;letter-spacing:.5px}
#lines{position:absolute;top:52px;left:50%;transform:translateX(-50%);width:min(760px,94%);
       max-height:calc(100% - 96px);background:#0b1219f5;border:1px solid #24384a;border-radius:4px;
       display:none;flex-direction:column;pointer-events:all;z-index:60}
#lines.open{display:flex}
#ln-h{display:flex;align-items:center;gap:10px;padding:9px 12px;border-bottom:1px solid #1c2833;flex-shrink:0}
#ln-h b{color:#5cc2ff;font:11px 'Consolas',monospace;letter-spacing:1px}
#ln-h span{color:#3d566e;font:9px 'Consolas',monospace;flex:1}
#ln-b{overflow-y:auto;padding:4px 0 10px}
table.ls{width:100%;border-collapse:collapse;font:9px 'Consolas',monospace}
table.ls th{color:#33465a;text-align:left;padding:5px 8px;border-bottom:1px solid #1c2833;
            position:sticky;top:0;background:#0b1219;font-weight:normal}
table.ls td{color:#7e99b0;padding:4px 8px;border-bottom:1px solid #121b23;vertical-align:top}
table.ls td.no{color:#5cc2ff}
table.ls tr:hover td{background:#101a24}
.swatch{display:inline-block;width:16px;height:3px;border-radius:2px;margin-right:6px;vertical-align:middle}
#ln-note{color:#3d566e;font:9px 'Consolas',monospace;padding:9px 12px;line-height:1.7}
@media(max-width:900px){#titleblock,#hint{display:none}#spec{width:190px}
  table.ls td:nth-child(5),table.ls th:nth-child(5){display:none}}
@media(max-width:620px){#legend{display:none}#spec{width:158px}#north{display:none}}
</style>

<div id="wrap">
<canvas id="c3d"></canvas>
<div id="hud">

  <div id="bar">
    <span class="blab">VIEW</span>
    <button class="b on" id="b3d"  onclick="setMode('3d')">3D MODEL</button>
    <button class="b"    id="btop" onclick="setMode('top')">TOP VIEW / PLOT PLAN</button>
    <div class="sep"></div>
    <button class="b" onclick="resetCam()">FIT</button>
    <button class="b" onclick="zoomBy(1.25)">ZOOM +</button>
    <button class="b" onclick="zoomBy(0.8)">ZOOM &minus;</button>
    <div class="sep"></div>
    <span class="blab">SECTION</span>
    <button class="b on" id="z-all" onclick="focusBay(0)">ALL</button>
    <button class="b" id="z-1" onclick="focusBay(1)">1 LEACHING</button>
    <button class="b" id="z-2" onclick="focusBay(2)">2 PURIFICATION</button>
    <button class="b" id="z-3" onclick="focusBay(3)">3 PRECIPITATION</button>
    <button class="b" id="z-4" onclick="focusBay(4)">4 DRYING</button>
    <button class="b" id="z-5" onclick="focusBay(5)">5 WATER RECOVERY</button>
    <div class="sep"></div>
    <button class="b on" id="b-lab"  onclick="toggleLabels()">TAGS: S</button>
    <button class="b on" id="b-grid" onclick="toggleGrid()">GRID</button>
    <button class="b"    id="b-flow" onclick="toggleFlow()">FLOW ANIM</button>
    <button class="b"    id="b-sh"   onclick="toggleShadows()">SHADOWS</button>
    <div class="sep"></div>
    <button class="b"    id="b-line" onclick="showLines()">LINE SCHEDULE</button>
  </div>

  <div id="mode-label">3D EQUIPMENT MODEL</div>
  <div id="mode-sub">drag = orbit &nbsp;|&nbsp; wheel = zoom &nbsp;|&nbsp; right-drag = pan &nbsp;|&nbsp; click item = spec</div>

  <div id="spec">
    <div id="sp-tag">PLANT OVERVIEW</div>
    <div id="sp-name">ZnO recovery from zinc ash</div>
    <div id="sp-body"></div>
  </div>

  <div id="legend"><div id="lg-title">LINE SERVICES</div></div>

  <svg id="north" viewBox="0 0 58 58"></svg>

  <div id="titleblock">
    <div id="tb-h">
      <b>JAMP INDUSTRIES</b>
      <div>ZINC OXIDE RECOVERY PLANT &mdash; 500 kg/batch</div>
    </div>
    <div class="tb-r">
      <div class="tb-c"><span>DRAWING</span>PLOT PLAN + 3D</div>
      <div class="tb-c"><span>DWG No.</span>JI-ZNO-LAY-01</div>
    </div>
    <div class="tb-r">
      <div class="tb-c"><span>PLOT</span>77.0 &times; 57.0 m</div>
      <div class="tb-c"><span>GRID</span>5.0 m sq.</div>
    </div>
    <div class="tb-r">
      <div class="tb-c"><span>SCALE</span>1 : 200 (A1)</div>
      <div class="tb-c"><span>REV</span>R2 &mdash; ISSUED</div>
    </div>
  </div>

  <div id="hint">click any equipment for its data sheet</div>

  <div id="sbar">
    <span id="coords">E 0.0 m &nbsp; N 0.0 m</span>
    <span id="s-mode">MODE: 3D</span>
    <span id="s-zoom">ZOOM: 100%</span>
    <span id="s-count"></span>
    <span style="margin-left:auto;color:#1a2530">JI-ZNO-LAY-01 &nbsp;|&nbsp; units: mm / m / KL</span>
  </div>

  <div id="lines">
    <div id="ln-h"><b>LINE SCHEDULE</b>
      <span>every run in the model, checked against the flow sheet</span>
      <button class="b" onclick="showLines()">CLOSE</button></div>
    <div id="ln-b"></div>
  </div>

  <div id="tip"></div>
</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ═══════════════════════════════════════════════════════════════════════════
   1 ── TOKENS
   ═══════════════════════════════════════════════════════════════════════════ */

/** 1 world unit = 0.1 m. Helper: M(4.5) -> 45 units = 4.5 metres. */
const M = m => m * 10;

/* Line service colours — each service is a togglable layer (see legend). */
const SVC = {
  WATER : {c:0x2e93ff, n:'Raw / process water (well)'},
  ACID  : {c:0xff9a2b, n:'Hydrochloric acid (HCl)'},
  LIQUOR: {c:0x1fd68b, n:'ZnCl\u2082 liquor (filtrate)'},
  ALKALI: {c:0xa96cff, n:'Alkali / NaOH solution'},
  SLURRY: {c:0x93a4b5, n:'Reaction slurry to press'},
  SOLID : {c:0xc98b3a, n:'Filter cake / dry solids'},
  BRINE : {c:0xf0c53a, n:'Spent brine to RO'},
  PERM  : {c:0x2fded0, n:'RO permeate recycle'},
  GAS   : {c:0xff5a3c, n:'Hot air / dryer exhaust'},
  WASTE : {c:0x62727f, n:'Residue / sludge / reject'}
};

/* Pipe-rack tiers. Every long run sits on its own elevation so that lines never
   coincide and never pass through a vessel (tallest tank T-04 top = 4.2 m). */
const TIER = {
  PERM:M(8.6), WATER:M(8.0), ACID:M(7.4), ALKALI:M(6.8),
  LIQUOR:M(6.2), SLURRY:M(5.6), BRINE:M(5.0), GAS:M(4.4), SOLID:M(3.4), LOW:M(0.9)
};

const PLINTH = M(0.6);            // all vessels stand on a 600 mm plinth
const PLOT   = {x0:-M(38), x1:M(39), z0:-M(34), z1:M(23)};

/* ═══════════════════════════════════════════════════════════════════════════
   2 ── SCENE
   ═══════════════════════════════════════════════════════════════════════════ */
const wrapEl = document.getElementById('wrap');
const W3D = () => wrapEl.clientWidth;
const H3D = () => wrapEl.clientHeight - 30;

const renderer = new THREE.WebGLRenderer({canvas:document.getElementById('c3d'), antialias:true});
/* Mobile GPUs choke on a 2048 shadow pass plus a 2x pixel ratio, so the
   renderer drops to a lighter tier on small / low-core devices. */
const LOWPOWER = (window.innerWidth < 900) || ((navigator.hardwareConcurrency||8) <= 4);
let shadowsOn = !LOWPOWER;
renderer.setPixelRatio(Math.min(devicePixelRatio, LOWPOWER?1.5:2));
renderer.shadowMap.enabled = shadowsOn;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x070a0e);

const camera    = new THREE.PerspectiveCamera(38, 1, 1, 12000);
const topCamera = new THREE.OrthographicCamera(-1,1,1,-1,1,2000);
topCamera.up.set(0,0,-1);                    // lock plan orientation: NORTH = up

let mode='3d', flowOn=false, labelMode=1, gridOn=true, animT=0;
let dirty=true;
const invalidate=()=>{dirty=true;};
let camState = {theta:-0.62, phi:0.40, r:M(96), tx:0, ty:0, tz:-M(3)};
let topState = {cx:0, cy:-M(5), zoom:0.85};

const groups = {labels:new THREE.Group(), grid:new THREE.Group(), zones:new THREE.Group()};
Object.values(groups).forEach(g=>scene.add(g));
const svcGroups = {};                        // one THREE.Group per line service
Object.keys(SVC).forEach(k=>{svcGroups[k]=new THREE.Group(); scene.add(svcGroups[k]);});

/* ═══════════════════════════════════════════════════════════════════════════
   3 ── HELPERS
   ═══════════════════════════════════════════════════════════════════════════ */
const mat = (c,rough=.62,metal=.25,emis=0x000000)=>
  new THREE.MeshStandardMaterial({color:c,roughness:rough,metalness:metal,emissive:emis,emissiveIntensity:.35});

const cyl  = (r1,r2,h,m,s=18)=>new THREE.Mesh(new THREE.CylinderGeometry(r1,r2,h,s),m);
const box  = (w,h,d,m)=>new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);
const ball = (r,m)=>new THREE.Mesh(new THREE.SphereGeometry(r,14,9),m);
const ring = (r,t,m)=>new THREE.Mesh(new THREE.TorusGeometry(r,t,5,16),m);

/** Tag plate that always faces the camera (readable in 3D and in plan). */
function tagSprite(tag, sub, colour, scale=1){
  const cv=document.createElement('canvas'); cv.width=320; cv.height=80;
  const g=cv.getContext('2d');
  g.fillStyle='rgba(8,13,19,0.80)'; g.fillRect(0,0,320,80);
  g.strokeStyle=colour; g.lineWidth=2; g.strokeRect(1,1,318,78);
  g.fillStyle=colour; g.fillRect(1,1,5,78);
  g.font='bold 34px Consolas,monospace'; g.fillStyle=colour;
  g.fillText(tag, 14, 36);
  if(sub){ g.font='20px Consolas,monospace'; g.fillStyle='#8fa6bb'; g.fillText(sub, 14, 65); }
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({
    map:new THREE.CanvasTexture(cv), transparent:true, depthTest:false, depthWrite:false}));
  sp.userData.base=[M(3.4)*scale, M(0.85)*scale];      // tag plates kept small
  sp.scale.set(sp.userData.base[0], sp.userData.base[1], 1);
  sp.renderOrder = 900;
  return sp;
}

/** Flat text painted on the ground — reads correctly in the plan view. */
function groundText(text, x, z, w, colour='#2c5c85', size=44, align='left'){
  const cv=document.createElement('canvas'); cv.width=512; cv.height=64;
  const g=cv.getContext('2d');
  g.font=`${Math.round(size/2)}px Consolas,monospace`; g.fillStyle=colour;
  g.textAlign=align; g.textBaseline='middle';
  g.fillText(text, align==='center'?256:4, 34);
  const pl=new THREE.Mesh(new THREE.PlaneGeometry(w, w/8),
    new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(cv),transparent:true,depthWrite:false}));
  pl.rotation.x=-Math.PI/2; pl.position.set(x, 0.6, z);
  return pl;
}

/* ── pipe primitives ───────────────────────────────────────────────────── */
function segment(a,b,colour,r){
  const A=new THREE.Vector3(...a), B=new THREE.Vector3(...b), L=A.distanceTo(B);
  if(L<0.5) return null;
  const m=new THREE.Mesh(new THREE.CylinderGeometry(r,r,L,8), null);
  m.position.copy(A).lerp(B,.5);
  m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0), B.clone().sub(A).normalize());
  return m;
}

/**
 * Collects a polyline as pipe barrels + elbows. Nothing is added to the scene
 * here: bakePipes() welds each service into ONE mesh, which takes the drawing
 * from ~180 draw calls down to 10. That is the single biggest win on a phone.
 */
const pipeParts={};
function pipe(svc, pts, r=M(0.09)){
  const colour=SVC[svc].c, bin=(pipeParts[svc]=pipeParts[svc]||[]);
  for(let i=0;i<pts.length-1;i++){
    const s=segment(pts[i],pts[i+1],colour,r); if(s) bin.push(s);
    if(i>0){ const e=ball(r*1.3,null); e.position.set(...pts[i]); bin.push(e); }
  }
  return pts;
}

/** Welds an array of positioned meshes into one BufferGeometry. */
function weld(meshes){
  const pos=[], nor=[];
  meshes.forEach(m=>{
    m.updateMatrix();
    const g=(m.geometry.index? m.geometry.toNonIndexed() : m.geometry.clone()).applyMatrix4(m.matrix);
    const P=g.attributes.position.array, N=g.attributes.normal.array;
    for(let i=0;i<P.length;i++) pos.push(P[i]);
    for(let i=0;i<N.length;i++) nor.push(N[i]);
    g.dispose();
  });
  const out=new THREE.BufferGeometry();
  out.setAttribute('position', new THREE.Float32BufferAttribute(pos,3));
  out.setAttribute('normal',   new THREE.Float32BufferAttribute(nor,3));
  return out;
}

function bakePipes(){
  Object.keys(pipeParts).forEach(svc=>{
    const colour=SVC[svc].c;
    const m=new THREE.Mesh(weld(pipeParts[svc]), mat(colour,.35,.6,colour));
    m.material.emissiveIntensity=.20;
    svcGroups[svc].add(m);
    pipeParts[svc].forEach(x=>x.geometry.dispose());
    pipeParts[svc]=null;
  });
}

/**
 * ORTHOGONAL ROUTER — the fix for the diagonal lines in the previous drawing.
 * Every run leaves its nozzle vertically, travels on a rack tier in X then Z
 * (or Z then X), and drops vertically into the receiving nozzle.
 */
function route(a, b, tier, order='xz'){
  const p=[[...a],[a[0],tier,a[2]]];
  if(order==='xz'){ p.push([b[0],tier,a[2]],[b[0],tier,b[2]]); }
  else            { p.push([a[0],tier,b[2]],[b[0],tier,b[2]]); }
  p.push([...b]);
  return p.filter((q,i,arr)=> i===0 || Math.hypot(q[0]-arr[i-1][0],q[1]-arr[i-1][1],q[2]-arr[i-1][2])>0.4);
}

/* ── animated flow markers: one Points cloud per service, not one mesh each ── */
const flowPaths={}, flowSets=[];
function flow(svc, pts){ (flowPaths[svc]=flowPaths[svc]||[]).push(pts); }

function bakeFlow(){
  Object.keys(flowPaths).forEach(svc=>{
    const items=[];
    flowPaths[svc].forEach(pts=>{
      let total=0;
      for(let i=1;i<pts.length;i++)
        total+=new THREE.Vector3(...pts[i]).distanceTo(new THREE.Vector3(...pts[i-1]));
      const n=Math.max(2, Math.floor(total/M(3.4)));
      for(let i=0;i<n;i++) items.push({pts, off:i/n});
    });
    const geo=new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.Float32BufferAttribute(new Float32Array(items.length*3),3));
    const pts=new THREE.Points(geo, new THREE.PointsMaterial({
      color:SVC[svc].c, size:5, sizeAttenuation:false, depthTest:true}));
    pts.visible=false; pts.frustumCulled=false;
    svcGroups[svc].add(pts);
    flowSets.push({obj:pts, items, attr:geo.attributes.position});
  });
}

function stepFlow(){
  const v=new THREE.Vector3();
  flowSets.forEach(set=>{
    const a=set.attr.array;
    set.items.forEach((it,i)=>{
      v.copy(pointAt(it.pts,(animT+it.off)%1));
      a[i*3]=v.x; a[i*3+1]=v.y; a[i*3+2]=v.z;
    });
    set.attr.needsUpdate=true;
  });
}
function pointAt(pts,t){
  const segs=[]; let total=0;
  for(let i=1;i<pts.length;i++){
    const d=new THREE.Vector3(...pts[i]).distanceTo(new THREE.Vector3(...pts[i-1]));
    segs.push(d); total+=d;
  }
  let want=t*total, acc=0;
  for(let i=0;i<segs.length;i++){
    if(acc+segs[i]>=want) return new THREE.Vector3(...pts[i]).lerp(new THREE.Vector3(...pts[i+1]),(want-acc)/segs[i]);
    acc+=segs[i];
  }
  return new THREE.Vector3(...pts[pts.length-1]);
}

/* ═══════════════════════════════════════════════════════════════════════════
   4 ── EQUIPMENT BUILDERS
  
